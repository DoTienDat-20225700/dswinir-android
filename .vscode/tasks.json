{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build và chạy DSwinIR",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tools/run_android.sh", "--build"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "Android: Mở APK có sẵn",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tools/run_android.sh", "--apk"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "runOptions": {"instanceLimit": 1}
    }
  ]
}
